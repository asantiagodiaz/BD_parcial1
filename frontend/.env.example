# Copiar a .env . URL base de la API del backend (5.4).
#
# Local con el backend en localhost:8000  -> deja VITE_API_URL vacio y usa el
# proxy de Vite (/api -> localhost:8000).
#
# Contra AWS (Learner Lab): pon la IP publica actual de la EC2. Ojo: cambia cada
# vez que el Lab reinicia la instancia (ver docs/10-como-interactuar.md).
#   VITE_API_URL=http://<IP-EC2>:8000
VITE_API_URL=
