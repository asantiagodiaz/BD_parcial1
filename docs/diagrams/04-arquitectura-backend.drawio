    <diagram id="be-flujo-reserva" name="Backend - Flujo de reserva (bloqueo)">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="tt" value="5.4.2  Flujo de POST /reservations  -  bloqueo pesimista contra la sobreventa (NFR-03, NFR-04)" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="30" y="15" width="1200" height="24" as="geometry"/>
                </mxCell>
                <!-- lifelines -->
                <mxCell id="ll_c" value="Cliente (SPA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
