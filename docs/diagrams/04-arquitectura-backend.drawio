                    <mxGeometry x="360" y="60" width="150" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ll_db" value="PostgreSQL OLTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="720" y="60" width="170" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ll_a" value="audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="60" width="120" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="lc" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="115" y="100" as="sourcePoint"/>
                        <mxPoint x="115" y="1120" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="lb" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="435" y="100" as="sourcePoint"/>
                        <mxPoint x="435" y="1120" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ldb" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="805" y="100" as="sourcePoint"/>
                        <mxPoint x="805" y="1120" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="la" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1140" y="100" as="sourcePoint"/>
                        <mxPoint x="1140" y="1120" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <!-- mensajes -->
                <mxCell id="s1" value="POST /reservations { itinerario[segmentos], pasajeros, cabina }" style="html=1;endArrow=block;rounded=0;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="115" y="140" as="sourcePoint"/>
                        <mxPoint x="435" y="140" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s2" value="BEGIN" style="html=1;endArrow=block;rounded=0;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="435" y="185" as="sourcePoint"/>
                        <mxPoint x="805" y="185" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s3" value="SELECT ... FROM inventario_asientos WHERE id_instancia_vuelo = ANY(:ids) AND cabina=:c ORDER BY id_instancia_vuelo FOR UPDATE" style="html=1;endArrow=block;rounded=0;fontSize=10;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="435" y="235" as="sourcePoint"/>
                        <mxPoint x="805" y="235" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="n3" value="Bloquea las filas de inventario de cada segmento.&#xa;Cualquier otra reserva por esas mismas filas ESPERA aqui." style="text;html=1;fontSize=10;fontStyle=2;align=left;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="520" y="255" width="470" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="filas bloqueadas (totales, vendidos, retenidos)" style="html=1;endArrow=block;rounded=0;dashed=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="805" y="320" as="sourcePoint"/>
                        <mxPoint x="435" y="320" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <!-- decision -->
                <mxCell id="dec" value="para cada segmento:&#xa;totales - vendidos - retenidos  &gt;=  num_pasajeros ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="300" y="360" width="270" height="90" as="geometry"/>
                </mxCell>
                <!-- rama NO -->
                <mxCell id="sNo" value="ROLLBACK" style="html=1;endArrow=block;rounded=0;strokeColor=#b85450;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="435" y="475" as="sourcePoint"/>
                        <mxPoint x="805" y="475" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="sNo2" value="HTTP 409 Conflict  -  &#39;vuelo agotado en esa cabina&#39;  (NFR-03)" style="html=1;endArrow=block;rounded=0;strokeColor=#b85450;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="435" y="510" as="sourcePoint"/>
                        <mxPoint x="115" y="510" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="lblNo" value="NO (algun segmento sin cupo)" style="text;html=1;fontSize=10;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="580" y="455" width="230" height="20" as="geometry"/>
                </mxCell>
                <!-- rama SI -->
                <mxCell id="lblSi" value="SI (todos los segmentos tienen cupo)" style="text;html=1;fontSize=10;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="150" y="560" width="260" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="s5" value="UPDATE inventario_asientos SET asientos_retenidos = asientos_retenidos + :n  (cada fila)" style="html=1;endArrow=block;rounded=0;fontSize=10;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="435" y="595" as="sourcePoint"/>
                        <mxPoint x="805" y="595" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="n5" value="CHECK (vendidos + retenidos &lt;= totales) = ultima barrera del motor" style="text;html=1;fontSize=10;fontStyle=2;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="520" y="612" width="420" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="s6" value="INSERT reserva (RETENIDA, retenida_hasta = now()+15min), itinerario, segmentos, reserva_pasajero" style="html=1;endArrow=block;rounded=0;fontSize=10;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="435" y="665" as="sourcePoint"/>
                        <mxPoint x="805" y="665" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s7" value="registrar EVENTO_RESERVA (&#39;CREADA&#39; / &#39;RETENIDA&#39;)  (NFR-09)" style="html=1;endArrow=block;rounded=0;fontSize=10;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="435" y="710" as="sourcePoint"/>
                        <mxPoint x="1140" y="710" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s8" value="COMMIT   (libera los locks)" style="html=1;endArrow=block;rounded=0;fontStyle=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="435" y="755" as="sourcePoint"/>
                        <mxPoint x="805" y="755" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s9" value="201 Created  { codigo_reserva, estado: RETENIDA, retenida_hasta }" style="html=1;endArrow=block;rounded=0;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="435" y="800" as="sourcePoint"/>
                        <mxPoint x="115" y="800" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="box_after" value="Despues:  POST /reservations/{code}/pay  -&gt;  nueva TX con FOR UPDATE de las mismas filas:&#xa;asientos_retenidos -= n ;  asientos_vendidos += n ;  reserva.estado = CONFIRMADA ;  emitir BILLETE por pasajero-segmento ;  EVENTO_RESERVA(&#39;PAGADA&#39;,&#39;CONFIRMADA&#39;).&#xa;&#xa;jobs (cada 1 min):  por cada reserva RETENIDA con retenida_hasta &lt; now()  -&gt;  TX FOR UPDATE:  asientos_retenidos -= n ;  estado = EXPIRADA ;  EVENTO_RESERVA(&#39;EXPIRADA&#39;).  (FR-07)" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacingLeft=8;spacingTop=6;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="120" y="850" width="1080" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="box_dead" value="Prevencion de deadlock:  el ORDER BY id_instancia_vuelo hace que dos reservas multi-tramo que comparten vuelos&#xa;los bloqueen siempre en el mismo orden.   Transaccion corta:  sin llamadas externas entre BEGIN y COMMIT (el pago va aparte)." style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=8;spacingTop=6;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="120" y="1020" width="1080" height="70" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>