<mxfile host="app.diagrams.net"><diagram name="Arquitectura parcial 3" id="p3"><mxGraphModel dx="1280" dy="720" grid="1" gridSize="10" page="1" pageWidth="1280" pageHeight="1045"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="z_aws" value="AWS Academy Learner Lab · us-east-1 · VPC por defecto · una sola AZ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232f3e;strokeWidth=2;dashed=1;verticalAlign=top;align=right;spacingRight=12;fontStyle=1;fontColor=#232f3e;" vertex="1" parent="1"><mxGeometry x="250" y="15" width="1015" height="690" as="geometry"/></mxCell><mxCell id="z_rapido" value="Ruta transaccional y camino rápido (segundos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c2255c;strokeWidth=2;dashed=1;verticalAlign=top;align=right;spacingRight=12;fontStyle=1;fontColor=#c2255c;" vertex="1" parent="1"><mxGeometry x="270" y="50" width="975" height="225" as="geometry"/></mxCell><mxCell id="z_anal" value="Camino analítico (minutos): landing zone y modelo estrella" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5f3dc4;strokeWidth=2;dashed=1;verticalAlign=top;align=right;spacingRight=12;fontStyle=1;fontColor=#5f3dc4;" vertex="1" parent="1"><mxGeometry x="270" y="295" width="975" height="395" as="geometry"/></mxCell><mxCell id="cli" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;buscar · reservar · cancelar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#495057;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="15" y="75" width="185" height="70" as="geometry"/></mxCell><mxCell id="ger" value="&lt;b&gt;Gerente&lt;/b&gt;&lt;br&gt;panel en vivo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#495057;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="15" y="180" width="185" height="70" as="geometry"/></mxCell><mxCell id="ec2" value="&lt;b&gt;EC2 t3.small&lt;/b&gt;&lt;br&gt;FastAPI + React + PostgreSQL 16&lt;br&gt;hilo consumidor (vista en vivo)&lt;br&gt;job refresh-star" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe8cc;strokeColor=#d9480f;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="250" height="130" as="geometry"/></mxCell><mxCell id="kds" value="&lt;b&gt;Kinesis Data Stream&lt;/b&gt;&lt;br&gt;provisionado · 1 shard · 24 h&lt;br&gt;sin enhanced fan-out&lt;br&gt;solo mientras se prueba" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffdeeb;strokeColor=#c2255c;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="95" width="200" height="120" as="geometry"/></mxCell><mxCell id="fh" value="&lt;b&gt;Kinesis Data Firehose&lt;/b&gt;&lt;br&gt;búfer 60 s · gzip&lt;br&gt;un evento por línea" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffdeeb;strokeColor=#c2255c;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="355" width="200" height="90" as="geometry"/></mxCell><mxCell id="raw" value="&lt;b&gt;S3 raw/events/&lt;/b&gt;&lt;br&gt;landing zone (append-only)&lt;br&gt;JSON por línea, con duplicados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="355" width="220" height="90" as="geometry"/></mxCell><mxCell id="ath" value="&lt;b&gt;Athena&lt;/b&gt;&lt;br&gt;workgroup airline-p3&lt;br&gt;CTAS · tope 1 GB por consulta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5dbff;strokeColor=#5f3dc4;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="545" width="200" height="90" as="geometry"/></mxCell><mxCell id="glue" value="&lt;b&gt;Glue Data Catalog&lt;/b&gt;&lt;br&gt;base airline_star&lt;br&gt;3 dimensiones + 2 hechos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5dbff;strokeColor=#5f3dc4;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="545" width="250" height="90" as="geometry"/></mxCell><mxCell id="star" value="&lt;b&gt;S3 star/&lt;/b&gt;&lt;br&gt;Parquet · hechos por month&lt;br&gt;reconstruido cada 10 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="545" width="220" height="90" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Datos del equipo (semilla 963)&lt;/b&gt;&lt;br&gt;9 rutas · 3 cambian de categoría&lt;br&gt;replay: 20.509 → 19.912 eventos&lt;br&gt;Costo proyectado ≈ US$ 18,2 / mes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#e67700;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="285" y="345" width="285" height="130" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Publicar sin frenar la API (R2)&lt;/b&gt;&lt;br&gt;búsquedas: cola + PutRecords por lote&lt;br&gt;reservas: PutRecord tras el commit&lt;br&gt;p95 = 0,335 s con 50 clientes&lt;br&gt;200 / 200 eventos en el stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#e67700;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="960" y="85" width="280" height="140" as="geometry"/></mxCell><mxCell id="e0" value="HTTP" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.3;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cli" target="ec2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="/manager" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ger" target="ec2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="eventos" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.3;entryX=0;entryY=0.3;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ec2" target="kds"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="GetRecords c/1 s" style="endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.75;entryX=1;entryY=0.75;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="kds" target="ec2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="lee el shard" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="kds" target="fh"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="cada 60 s" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fh" target="raw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="lee todo" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.3;exitY=1;entryX=0.7;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="raw" target="ath"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="lanza CTAS (refresh-star)" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.6;exitY=1;entryX=0.3;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ec2" target="ath"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="Parquet" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ath" target="star"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="registra tablas" style="endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ath" target="glue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="3" y="63" width="24" height="24" as="geometry"/></mxCell><mxCell id="b2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="3" y="168" width="24" height="24" as="geometry"/></mxCell><mxCell id="b3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="288" y="78" width="24" height="24" as="geometry"/></mxCell><mxCell id="b4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="708" y="83" width="24" height="24" as="geometry"/></mxCell><mxCell id="b5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="708" y="343" width="24" height="24" as="geometry"/></mxCell><mxCell id="b6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="988" y="343" width="24" height="24" as="geometry"/></mxCell><mxCell id="b7" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="708" y="533" width="24" height="24" as="geometry"/></mxCell><mxCell id="b8" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="288" y="533" width="24" height="24" as="geometry"/></mxCell><mxCell id="b9" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="988" y="533" width="24" height="24" as="geometry"/></mxCell><mxCell id="leyenda" value="&lt;b&gt;¿Qué es cada cosa?&lt;/b&gt;&lt;br&gt;&lt;b&gt;1. Cliente&lt;/b&gt;: Persona que busca, reserva o cancela desde el navegador (página /). Cada acción produce exactamente un evento.&lt;br&gt;&lt;b&gt;2. Gerente&lt;/b&gt;: Ve en /manager las búsquedas, reservas y conversión de los últimos minutos, y puede pedir que se reconstruya el modelo estrella.&lt;br&gt;&lt;b&gt;3. EC2 t3.small&lt;/b&gt;: Una sola máquina: API, frontend, PostgreSQL y un hilo que lee el stream y cuenta eventos por la hora en que ocurrieron (vista en vivo).&lt;br&gt;&lt;b&gt;4. Kinesis Data Stream&lt;/b&gt;: Cola de eventos con 1 shard. Se crea con un script al empezar a probar y se borra al terminar, porque se cobra por cada hora que existe.&lt;br&gt;&lt;b&gt;5. Kinesis Data Firehose&lt;/b&gt;: Servicio gestionado que lee el stream y cada 60 s escribe un archivo comprimido en S3, con un evento por línea.&lt;br&gt;&lt;b&gt;6. S3 raw/events/&lt;/b&gt;: La landing zone: todos los eventos tal como llegaron, incluidos duplicados, tardíos y desordenados. Nunca se modifica.&lt;br&gt;&lt;b&gt;7. Athena&lt;/b&gt;: Ejecuta SQL sobre S3 sin servidores. Reconstruye la estrella (CTAS) y responde las preguntas de negocio; cobra solo por los datos que lee.&lt;br&gt;&lt;b&gt;8. Glue Data Catalog&lt;/b&gt;: Guarda cómo son las tablas (columnas, tipos, particiones por mes) para que Athena las entienda. Las crea el propio refresco.&lt;br&gt;&lt;b&gt;9. S3 star/&lt;/b&gt;: El modelo estrella en Parquet: dim_date, dim_route (SCD tipo 2), dim_fare_class, fact_search y fact_booking_event." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#868e96;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="15" y="725" width="1250" height="305" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>