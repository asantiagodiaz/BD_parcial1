# Copiar a .env y ajustar. NUNCA subir .env con credenciales reales.
#
# Local (PostgreSQL nativo, ver setup-postgres-local.sh):
#   las dos bases viven en la misma instancia local, puerto 5432.
OLTP_DATABASE_URL=postgresql+psycopg://aerolinea:aerolinea@localhost:5432/aerolinea_oltp
OLAP_DATABASE_URL=postgresql+psycopg://aerolinea:aerolinea@localhost:5432/aerolinea_olap
#
# En AWS (Learner Lab) seran dos instancias RDS distintas:
#   OLTP_DATABASE_URL=postgresql+psycopg://<user>:<pass>@<endpoint-oltp>:5432/aerolinea
#   OLAP_DATABASE_URL=postgresql+psycopg://<user>:<pass>@<endpoint-olap>:5432/aerolinea

# Hold temporal de asientos (minutos) - FR-06 / S4
HOLD_MINUTES=15

# Tiempos de conexion validos para itinerarios con escala (minutos) - FR-02
MIN_CONNECTION_MINUTES=45
MAX_CONNECTION_MINUTES=360

# 5.5: origenes permitidos para la SPA (CORS). "*" para la demo, o lista separada
# por comas, p. ej.:
#   CORS_ORIGINS=http://localhost:5173,http://mi-bucket.s3-website-us-east-1.amazonaws.com
CORS_ORIGINS=*
