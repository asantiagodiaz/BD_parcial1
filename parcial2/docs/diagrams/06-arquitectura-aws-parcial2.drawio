<mxfile host="app.diagrams.net"><diagram name="Arquitectura parcial 2" id="p2"><mxGraphModel dx="1280" dy="720" grid="1" gridSize="10" page="1" pageWidth="1280" pageHeight="1045"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="z_aws" value="AWS Academy Learner Lab · us-east-1 · VPC por defecto · una sola AZ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232f3e;strokeWidth=2;dashed=1;verticalAlign=top;align=right;spacingRight=12;fontStyle=1;fontColor=#232f3e;" vertex="1" parent="1"><mxGeometry x="250" y="15" width="1015" height="690" as="geometry"/></mxCell><mxCell id="z_trans" value="Ruta transaccional (reservas) · nunca se mezcla con la analítica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1864ab;strokeWidth=2;dashed=1;verticalAlign=top;align=right;spacingRight=12;fontStyle=1;fontColor=#1864ab;" vertex="1" parent="1"><mxGeometry x="270" y="50" width="975" height="225" as="geometry"/></mxCell><mxCell id="z_anal" value="Ruta analítica (limpieza por lotes + consultas del panel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5f3dc4;strokeWidth=2;dashed=1;verticalAlign=top;align=right;spacingRight=12;fontStyle=1;fontColor=#5f3dc4;" vertex="1" parent="1"><mxGeometry x="270" y="295" width="975" height="395" as="geometry"/></mxCell><mxCell id="cli" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;buscar y reservar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#495057;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="15" y="75" width="150" height="70" as="geometry"/></mxCell><mxCell id="ger" value="&lt;b&gt;Gerente&lt;/b&gt;&lt;br&gt;panel de ocupación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#495057;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="15" y="180" width="150" height="70" as="geometry"/></mxCell><mxCell id="ec2" value="&lt;b&gt;EC2 t3.small&lt;/b&gt;&lt;br&gt;API FastAPI + frontend React&lt;br&gt;(compilado · un proceso · :8000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe8cc;strokeColor=#d9480f;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="95" width="235" height="110" as="geometry"/></mxCell><mxCell id="rds" value="&lt;b&gt;RDS PostgreSQL&lt;/b&gt;&lt;br&gt;db.t3.micro · 1 AZ&lt;br&gt;privada (solo la EC2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0ebff;strokeColor=#1864ab;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="690" y="95" width="190" height="110" as="geometry"/></mxCell><mxCell id="ath" value="&lt;b&gt;Athena&lt;/b&gt;&lt;br&gt;workgroup airline-wg&lt;br&gt;tope 1 GB por consulta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5dbff;strokeColor=#5f3dc4;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="355" width="200" height="90" as="geometry"/></mxCell><mxCell id="glue" value="&lt;b&gt;Glue Data Catalog&lt;/b&gt;&lt;br&gt;2 tablas · partition&lt;br&gt;projection (sin crawlers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5dbff;strokeColor=#5f3dc4;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="545" width="200" height="90" as="geometry"/></mxCell><mxCell id="cur" value="&lt;b&gt;S3 curated/&lt;/b&gt;&lt;br&gt;Parquet por month=YYYY-MM&lt;br&gt;24 particiones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="355" width="220" height="90" as="geometry"/></mxCell><mxCell id="emr" value="&lt;b&gt;EMR · 1 × m4.large&lt;/b&gt;&lt;br&gt;PySpark: reglas C1–C5&lt;br&gt;efímero (--auto-terminate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe8cc;strokeColor=#d9480f;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="545" width="220" height="90" as="geometry"/></mxCell><mxCell id="raw" value="&lt;b&gt;S3 raw/&lt;/b&gt;&lt;br&gt;CSV crudo y sucio&lt;br&gt;2,0 M de reservas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;strokeWidth=2;align=center;" vertex="1" parent="1"><mxGeometry x="940" y="545" width="200" height="90" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Datos del equipo (semilla 963)&lt;/b&gt;&lt;br&gt;9 rutas · 150 asientos por vuelo · K = 8&lt;br&gt;24 meses (2023-01 a 2024-12)&lt;br&gt;Costo proyectado ≈ US$ 31,9 / mes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#e67700;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="900" y="345" width="330" height="130" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;R2: sin sobreventa&lt;/b&gt;&lt;br&gt;UPDATE ... WHERE seats_sold &amp;lt; capacity&lt;br&gt;afecta 1 fila → 201; 0 filas → 409&lt;br&gt;probado con 50 clientes simultáneos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#e67700;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="910" y="90" width="320" height="120" as="geometry"/></mxCell><mxCell id="e0" value="buscar / reservar" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.3;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cli" target="ec2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="panel /manager" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ger" target="ec2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="UPDATE atómico" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ec2" target="rds"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="consulta SQL a Athena" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ec2" target="ath"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="esquema de las 2 tablas" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ath" target="glue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="lee 1 mes" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ath" target="cur"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="escribe Parquet" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.5;entryY=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="emr" target="cur"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="lee CSV" style="endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="raw" target="emr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="3" y="63" width="24" height="24" as="geometry"/></mxCell><mxCell id="b2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="3" y="168" width="24" height="24" as="geometry"/></mxCell><mxCell id="b3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="318" y="83" width="24" height="24" as="geometry"/></mxCell><mxCell id="b4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="678" y="83" width="24" height="24" as="geometry"/></mxCell><mxCell id="b5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="318" y="343" width="24" height="24" as="geometry"/></mxCell><mxCell id="b6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="318" y="533" width="24" height="24" as="geometry"/></mxCell><mxCell id="b7" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="618" y="343" width="24" height="24" as="geometry"/></mxCell><mxCell id="b8" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="618" y="533" width="24" height="24" as="geometry"/></mxCell><mxCell id="b9" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#212529;fontColor=#ffffff;strokeColor=#212529;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="928" y="533" width="24" height="24" as="geometry"/></mxCell><mxCell id="leyenda" value="&lt;b&gt;¿Qué es cada cosa?&lt;/b&gt;&lt;br&gt;&lt;b&gt;1. Cliente&lt;/b&gt;: Persona que busca un vuelo y lo reserva desde el navegador. Es la página principal (/) del frontend.&lt;br&gt;&lt;b&gt;2. Gerente&lt;/b&gt;: Persona de la aerolínea que consulta la ocupación por ruta y mes en el panel (/manager): ve el porcentaje y el ranking de las 9 rutas.&lt;br&gt;&lt;b&gt;3. EC2 t3.small&lt;/b&gt;: Máquina virtual que ejecuta la API (FastAPI) y entrega el frontend React ya compilado. Es un solo proceso en el puerto 8000; no necesita Node.&lt;br&gt;&lt;b&gt;4. RDS PostgreSQL&lt;/b&gt;: Base de datos de vuelos y reservas. Es privada: solo la EC2 se conecta. Un UPDATE condicional impide vender un asiento de más.&lt;br&gt;&lt;b&gt;5. Athena&lt;/b&gt;: Ejecuta SQL directamente sobre los archivos de S3, sin servidor propio. El panel le pregunta la ocupación; cobra solo por los datos que lee.&lt;br&gt;&lt;b&gt;6. Glue Data Catalog&lt;/b&gt;: Guarda cómo son las 2 tablas (columnas y carpeta de S3) para que Athena las entienda. Con partition projection conoce los 24 meses sin crawlers.&lt;br&gt;&lt;b&gt;7. S3 curated/&lt;/b&gt;: Datos ya limpios en Parquet, una carpeta por mes (month=2024-01...). Una consulta de un mes solo lee su carpeta: por eso escanea tan poco.&lt;br&gt;&lt;b&gt;8. EMR (Spark)&lt;/b&gt;: Cluster temporal que lee los CSV, aplica las reglas de limpieza C1–C5 y escribe el Parquet. Se apaga solo al terminar, para no seguir cobrando.&lt;br&gt;&lt;b&gt;9. S3 raw/&lt;/b&gt;: El historial tal como llega: 2 millones de reservas en CSV, con rutas mal escritas, estados raros, filas repetidas y precios inválidos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#868e96;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="15" y="725" width="1250" height="305" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>